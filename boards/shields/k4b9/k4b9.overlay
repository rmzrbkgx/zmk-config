#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/analog-stick/modes.h>
/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };
    analog_stick0: analog_stick0 {
        compatible = "zmk,analog-stick";

        // Left stick
        // X = P0.02 / AIN0
        // Y = P0.03 / AIN1
        io-channels = <&adc 0>, <&adc 1>;

        // 仮値。実測後に変更する
        x-min = <0>;
        x-center = <2048>;
        x-max = <4095>;

        y-min = <0>;
        y-center = <2048>;
        y-max = <4095>;

        deadzone-percent = <5>;

        wait-period-idle = <100>;
        wait-period-active = <8>;

        status = "okay";
    };

    analog_stick1: analog_stick1 {
        compatible = "zmk,analog-stick";

        // Right stick
        // X = P0.04 / AIN2
        // Y = P0.29 / AIN5
        io-channels = <&adc 2>, <&adc 5>;

        // 仮値。実測後に変更する
        x-min = <0>;
        x-center = <2048>;
        x-max = <4095>;

        y-min = <0>;
        y-center = <2048>;
        y-max = <4095>;

        deadzone-percent = <5>;

        wait-period-idle = <100>;
        wait-period-active = <8>;

        status = "okay";
    };
    analog_stick_listener0: analog_stick_listener0 {
        compatible = "zmk,analog-stick-listener";
        device = <&analog_stick0>;

        layer0 {
            layers = <0>;
            mode = <ANALOG_STICK_MODE_MOUSE>;

            mouse-min-speed = <1>;
            mouse-max-speed = <20>;
        };
    };

    analog_stick_listener1: analog_stick_listener1 {
        compatible = "zmk,analog-stick-listener";
        device = <&analog_stick1>;

        layer0 {
            layers = <0>;
            mode = <ANALOG_STICK_MODE_MOUSE>;

            mouse-min-speed = <1>;
            mouse-max-speed = <20>;
        };
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 28 GPIO_ACTIVE_HIGH> // Col0 (P0.28)
            , <&gpio1  1 GPIO_ACTIVE_HIGH> // Col1 (P1.01)
            , <&gpio1  5 GPIO_ACTIVE_HIGH> // Col2 (P1.05)
            , <&gpio1  7 GPIO_ACTIVE_HIGH> // Col3 (P1.07)
            ;

        row-gpios
            = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row0 - Row0L (P0.15)
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row1 - Row1L (P0.19)
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row2 - Row0R (P1.15)
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row3 - Row1R (P1.14)
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row4 - Row2 (P0.09)
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row5 - Row3 (P0.10)
            , <&gpio1 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row6 - Row4 (P1.03)
            ;
    };

    encoder0: encoder0 {
        compatible = "alps,ec11";

        a-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        steps = <20>;
        status = "okay";
    };
    sensors: sensors {
        compatible = "zmk,keymap-sensors";

        sensors = <&encoder0>;

        triggers-per-rotation = <20>;
    };



    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <7>;
        columns = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3)
            RC(6,0) RC(6,1) RC(6,2) RC(6,3)
        >;
    };
};

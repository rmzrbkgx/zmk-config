/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 28 GPIO_ACTIVE_HIGH> // Col0 (P0.28)
            , <&gpio1  1 GPIO_ACTIVE_HIGH> // Col1 (P1.01)
            , <&gpio1  5 GPIO_ACTIVE_HIGH> // Col2 (P1.05)
            , <&gpio1  7 GPIO_ACTIVE_HIGH> // Col3 (P1.07)
            ;

        row-gpios
            = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row0 - Row0L (P0.15)
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row1 - Row1L (P0.19)
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row2 - Row0R (P1.15)
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row3 - Row1R (P1.14)
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row4 - Row2 (P0.09)
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row5 - Row3 (P0.10)
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row6 - Row4 (P0.31)
            ;
    };
};